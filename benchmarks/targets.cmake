file(GLOB_RECURSE APEX_FINGERPRINT_FILES CONFIGURE_DEPENDS
  "${PROJECT_SOURCE_DIR}/include/*.hpp" "${PROJECT_SOURCE_DIR}/src/*.cpp"
  "${PROJECT_SOURCE_DIR}/src/*.hpp" "${PROJECT_SOURCE_DIR}/benchmarks/*.cpp"
  "${PROJECT_SOURCE_DIR}/benchmarks/*.cmake" "${PROJECT_SOURCE_DIR}/benchmarks/*.in")
list(APPEND APEX_FINGERPRINT_FILES "${PROJECT_SOURCE_DIR}/CMakeLists.txt" "${PROJECT_SOURCE_DIR}/CMakePresets.json")
list(SORT APEX_FINGERPRINT_FILES)
set(APEX_SOURCE_HASH_INPUT "")
foreach(source IN LISTS APEX_FINGERPRINT_FILES)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(SHA256 "${source}" digest)
  file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${source}")
  string(APPEND APEX_SOURCE_HASH_INPUT "${relative}:${digest}\n")
endforeach()
string(SHA256 APEX_SOURCE_SHA256 "${APEX_SOURCE_HASH_INPUT}")
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE APEX_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0)
  set(APEX_GIT_COMMIT "uncommitted")
endif()
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE git_status ERROR_QUIET RESULT_VARIABLE status_result)
set(APEX_GIT_DIRTY false)
if(git_status OR NOT status_result EQUAL 0)
  set(APEX_GIT_DIRTY true)
endif()
set(APEX_SANITIZED false)
if(APEX_ENABLE_ASAN OR APEX_ENABLE_UBSAN OR APEX_ENABLE_TSAN)
  set(APEX_SANITIZED true)
endif()
string(TOUPPER "${CMAKE_BUILD_TYPE}" build_upper)
set(APEX_RECORDED_FLAGS "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${build_upper}} -std=c++20 -Wall -Wextra -Wpedantic -Wconversion -Wshadow")
if(APEX_ENABLE_ASAN)
  string(APPEND APEX_RECORDED_FLAGS " -fsanitize=address -fno-omit-frame-pointer")
endif()
if(APEX_ENABLE_UBSAN)
  string(APPEND APEX_RECORDED_FLAGS " -fsanitize=undefined -fno-omit-frame-pointer")
endif()
if(APEX_ENABLE_TSAN)
  string(APPEND APEX_RECORDED_FLAGS " -fsanitize=thread -fno-omit-frame-pointer")
endif()
configure_file("${PROJECT_SOURCE_DIR}/benchmarks/build_info.hpp.in"
  "${PROJECT_BINARY_DIR}/generated/apex/metrics/build_info.hpp" @ONLY)

add_library(apex_metrics benchmarks/latency/benchmark.cpp benchmarks/metadata.cpp benchmarks/export.cpp)
target_link_libraries(apex_metrics PUBLIC apex_core)
target_include_directories(apex_metrics PUBLIC "${PROJECT_BINARY_DIR}/generated")
if(APEX_ENABLE_BENCHMARKS)
  if(NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR APEX_SANITIZED)
    message(FATAL_ERROR "Benchmark executable requires an unsanitized Release build; use the benchmark preset")
  endif()
  add_executable(apex_benchmark benchmarks/main.cpp)
  target_link_libraries(apex_benchmark PRIVATE apex_metrics)
  add_executable(apex_profile benchmarks/profile.cpp)
  target_link_libraries(apex_profile PRIVATE apex_core)
endif()
